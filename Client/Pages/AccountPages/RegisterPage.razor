@page "/identity/account/register"
@layout AuthenticationLayout


<EditForm Model="User"
          OnValidSubmit="HandleRegistration"
          class="auth-card">

    <DataAnnotationsValidator />

    <header class="auth-header">
        <p class="auth-brand">EmployeeManage</p>
        <h1>Create an account</h1>
        <p>Enter your details to get started.</p>
    </header>

    <div class="auth-fields">
        <div class="auth-field">
            <label for="register-name">Full name</label>

            <InputText id="register-name"
                       class="auth-input"
                       autocomplete="name"
                       @bind-Value="User.Fullname" />

            <ValidationMessage For="@(() => User.Fullname)" />
        </div>

        <div class="auth-field">
            <label for="register-email">Email</label>

            <InputText id="register-email"
                       type="email"
                       class="auth-input"
                       autocomplete="email"
                       @bind-Value="User.Email" />

            <ValidationMessage For="@(() => User.Email)" />
        </div>

        <div class="auth-field">
            <label for="register-password">Password</label>

            <InputText id="register-password"
                       type="password"
                       class="auth-input"
                       autocomplete="new-password"
                       @bind-Value="User.Password" />

            <ValidationMessage For="@(() => User.Password)" />
        </div>

        <div class="auth-field">
            <label for="register-confirm-password">
                Confirm password
            </label>

            <InputText id="register-confirm-password"
                       type="password"
                       class="auth-input"
                       autocomplete="new-password"
                       @bind-Value="User.ConfirmPassword" />

            <ValidationMessage For="@(() => User.ConfirmPassword)" />
        </div>
    </div>

    <button type="submit"
            class="auth-submit"
            disabled="@ShowLoadButton">
        @if (ShowLoadButton)
        {
            <span class="spinner-border spinner-border-sm"
                  aria-hidden="true"></span>
            <span>Creating account...</span>
        }
        else
        {
            <span>Create account</span>
        }
    </button>

    <p class="auth-footer">
        Already have an account?
        <a href="/identity/account/login">Sign In</a>
    </p>
</EditForm>

@code {
    public bool ShowLoadButton { get; set; } = false;

    Register User = new();

    [CascadingParameter] public Task<AuthenticationState> AuthenticationState { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await ChechUserAuthentication();

    }

    async Task HandleRegistration()
    {
        ShowLoadButton = true;
        var result = await accountService.CreateAsync(User);

        if (result.Flag)
        {
            User = new();
        }
        else
        {
            await DisplayDialog(result.Message, "Alert");
        }
        ShowLoadButton = false;
    }
    private async Task DisplayDialog(string content, string title)
    {
        await dialogService.AlertAsync(content, title);
    }
    private async Task ChechUserAuthentication()
    {
        var user = (await AuthenticationState).User;
        bool isUserAuthenticated = user.Identity!.IsAuthenticated;
        //if user IS authenticated nav to home
        if (isUserAuthenticated)
            NavManager.NavigateTo("/home/dashboard");
    }
}
