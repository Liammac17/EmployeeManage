@page "/identity/account/login"

@layout AuthenticationLayout


<EditForm Model="User"
          OnValidSubmit="HandleLogin"
          class="auth-card">

    <DataAnnotationsValidator />

    <header class="auth-header">
        <p class="auth-brand">EmployeeManage</p>
        <h1>Sign in</h1>
        <p>Enter your account details to continue.</p>
    </header>

    <div class="auth-fields">
        <div class="auth-field">
            <label for="login-email">Email</label>

            <InputText id="login-email"
                       type="email"
                       class="auth-input"
                       autocomplete="username"
                       @bind-Value="User.Email" />

            <ValidationMessage For="@(() => User.Email)" />
        </div>

        <div class="auth-field">
            <label for="login-password">Password</label>

            <InputText id="login-password"
                       type="password"
                       class="auth-input"
                       autocomplete="current-password"
                       @bind-Value="User.Password" />

            <ValidationMessage For="@(() => User.Password)" />
        </div>
    </div>

    <button type="submit"
            class="auth-submit"
            disabled="@ShowLoadButton">
        @if (ShowLoadButton)
        {
            <span class="spinner-border spinner-border-sm"
                  aria-hidden="true"></span>
            <span>Signing in...</span>
        }
        else
        {
            <span>Sign in</span>
        }
    </button>

    <p class="auth-footer">
        Don't have an account?
        <a href="/identity/account/register">Register Here</a>
    </p>
</EditForm>

@code {

    public bool ShowLoadButton { get; set; } = false;
    Login User = new();

    [CascadingParameter] public Task<AuthenticationState> AuthenticationState { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await ChechUserAuthentication();

    }


    async Task HandleLogin()
    {
        ShowLoadButton = true;
        var result = await accountService.SignInAsync(User);
        if (result.Flag)
        {
            await DisplayDialog(result.Message, "Login Success");
            var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;
            await customAuthStateProvider.UpdateAuthenticationState(new UserSession()
                {
                    Token = result.Token,
                    RefreshToken = result.RefreshToken
                });
            ShowLoadButton = false;
            NavManager.NavigateTo("/home/dashboard", forceLoad: true);
        }
        else
        {
            await DisplayDialog(result.Message, "Alert");
        }
        ShowLoadButton = false;
    }

    private async Task DisplayDialog(string content, string title)
    {
        await dialogService.AlertAsync(content, title);
    }

    private async Task ChechUserAuthentication()
    {
        var user = (await AuthenticationState).User;
        bool isUserAuthenticated = user.Identity!.IsAuthenticated;
        if (isUserAuthenticated)
            NavManager.NavigateTo("/home/dashboard");
    }
    
}
